# Шаблон переменных окружения фронтенда (Vite).
# Скопируйте в .env.local для разработки. Все переменные опциональны.

# База API. По умолчанию "/api/v1" (в dev обслуживается прокси Vite,
# в prod - nginx по подпути). Можно задать полный URL.
# VITE_API_BASE=/api/v1

# X-API-Key для dev. В рантайме приоритетно значение из localStorage
# (вводится в интерфейсе). НЕ коммитить реальный ключ.
# VITE_API_KEY=

# Куда прокси Vite шлёт /api в dev (локальный или удалённый бэкенд).
# VITE_PROXY_TARGET=http://localhost:8000

# Базовый путь сборки для раздачи под подпутём за nginx (напр. /instore/app/).
# VITE_BASE=/
