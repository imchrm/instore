# Шаблон переменных окружения stories-backend.
# Скопируйте в отдельный файл (например instore.env) вне web-докрута,
# подставьте секреты и передайте контейнеру через: docker run --env-file instore.env ...
#
# Формат docker --env-file: KEY=VALUE, БЕЗ кавычек и без export.
# Значение с кавычками (API_KEYS="a:b") сломается - кавычки станут частью значения.

# --- Обязательные --------------------------------------------------------

# Пары "имя:ключ" через запятую (имя -> key_id, изоляция задач по key_id).
API_KEYS=mobile:CHANGE_ME

# --- Развёртывание за reverse-proxy --------------------------------------

# Публичный префикс пути (например /instore). Пусто = сервис в корне домена.
ROOT_PATH=

# --- Хранилище -----------------------------------------------------------

# Каталог данных внутри контейнера (совпадает с точкой монтирования тома).
DATA_DIR=/data
# Каталог cookies. По умолчанию ${DATA_DIR}/cookies.
# COOKIES_DIR=/data/cookies

# --- Лимиты и дефолты обработки ------------------------------------------

# TTL готовых кусков (сек) до перевода в expired и удаления.
JOB_TTL_SECONDS=1200
# Предел параллельной обработки задач.
MAX_CONCURRENT_JOBS=1
# Лимит размера исходного видео (МБ).
MAX_FILESIZE_MB=50
# Лимит длительности исходного видео (сек).
MAX_VIDEO_DURATION=1800
# Ограничение высоты по умолчанию (px).
MAX_HEIGHT_DEFAULT=1080
# Длина куска (сек).
SEGMENT_TIME_DEFAULT=45
# Предел интервала кейфреймов (сек); куски длиннее помечаются over_limit.
KEYFRAME_LIMIT_SEC=60
# Целевой FPS при транскодировании.
TARGET_FPS=30
# Период фоновой очистки по TTL (сек).
CLEANUP_INTERVAL_SEC=60

# --- Отдача кусков -------------------------------------------------------

# true - отдавать куски через X-Accel-Redirect (за nginx); false - FileResponse.
USE_XACCEL=false
# Internal-префикс локации nginx для X-Accel-Redirect (описывается на корне сервера).
XACCEL_INTERNAL_PREFIX=/_protected

# --- Прочее --------------------------------------------------------------

# Уровень логирования.
LOG_LEVEL=INFO
# Обновлять yt-dlp на старте контейнера (1/true/yes). Требует доступа к PyPI.
# YT_DLP_AUTO_UPDATE=false
